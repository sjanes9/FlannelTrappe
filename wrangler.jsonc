{
  // Flannel Trappe - Cloudflare Pages configuration.
  //
  // This file replaces the dashboard binding screens. Once it is in the
  // repo, Cloudflare reads bindings from here and IGNORES what the
  // dashboard says, so there is only one place to get things right.
  //
  // THREE VALUES BELOW NEED FILLING IN. They are marked FILL ME.
  // Everything else can stay as it is.

  "$schema": "node_modules/wrangler/config-schema.json",

  // Must match the Pages project name exactly, as shown in the
  // Workers & Pages breadcrumb. Yours reads "flanneltrappe".
  "name": "flanneltrappe",

  // The folder holding the site itself. index.html moves into public/.
  "pages_build_output_dir": "./public",

  "compatibility_date": "2026-08-01",

  // FILL ME: the namespace ID from Storage & databases > KV.
  // It is a 32-character hex string, NOT the name you gave it.
  "kv_namespaces": [
    {
      "binding": "SITE_KV",
      "id": "d6b1e8ba35f44abf89db3c39e8b5341b"
    }
  ],

  // FILL ME: your bucket name from the R2 page, if it differs.
  "r2_buckets": [
    {
      "binding": "SITE_R2",
      "bucket_name": "flanneltrappe-media"
    }
  ],

  "vars": {
    // FILL ME: the SHA-256 hash of your publish key, lowercase hex.
    //
    // On the MacBook, in Terminal, with your real key in the quotes:
    //     echo -n "your-publish-key" | shasum -a 256
    //
    // The -n matters. Without it you hash a trailing newline and the
    // key will never match. Paste only the hex, not the trailing dash.
    //
    // Publishing this hash is safe. It cannot be reversed into the key,
    // so long as the key is long and random rather than a dictionary
    // word. Make it 20+ characters of nonsense.
    "ADMIN_KEY_SHA256": "e3ac8ae61c03d626a42b5ace3cd8c5a320dbabb21b6cb8e8b7cc9f783ab81798"
  }
}
